#!/usr/bin/with-contenv sh
set -u
PHP_BIN="$(command -v php85 || command -v php || true)"; [ -n "$PHP_BIN" ] || exit 127
READY_CHECK=5
while true; do
  [ -d /opt/linnms/runtime/vendor/driver ] || exit 0
  if ! s6-setuidgid abc "$PHP_BIN" /opt/linnms/runtime/workers/access-ready.php >/dev/null; then sleep "$READY_CHECK"; continue; fi
  s6-setuidgid abc env LINNMS_COURIER_DAEMON=1 LINNMS_COURIER_SLOT=1 "$PHP_BIN" /opt/linnms/runtime/workers/courier.php || true
  sleep 60
done
